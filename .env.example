# Server Configuration
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000

# Database
DATABASE_PATH=./data/socc-training.db

# Authentication
# IMPORTANT: Generate strong secrets using the command below (min 32 characters)
# Run: node -e "console.log('JWT_SECRET=' + require('crypto').randomBytes(32).toString('hex'))"
# Run: node -e "console.log('SESSION_SECRET=' + require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=GENERATE_STRONG_SECRET_USING_COMMAND_ABOVE_MINIMUM_32_CHARS
JWT_EXPIRES_IN=24h
SESSION_SECRET=GENERATE_STRONG_SECRET_USING_COMMAND_ABOVE_MINIMUM_32_CHARS
BCRYPT_ROUNDS=12
MIN_PASSWORD_LENGTH=8

# Registration Mode
# Set to 'false' for testing/development to allow simple registration without invite codes
# Set to 'true' for production to require invite codes for all registrations
REQUIRE_INVITE_CODES=true
ALLOW_OPEN_REGISTRATION=false

# Invite Code Settings
DEFAULT_INVITE_EXPIRY_DAYS=30

# OAuth Configuration (configure for your provider)
OAUTH_CLIENT_ID=your-oauth-client-id
OAUTH_CLIENT_SECRET=your-oauth-client-secret
OAUTH_AUTH_URL=https://your-oauth-provider.com/oauth/authorize
OAUTH_TOKEN_URL=https://your-oauth-provider.com/oauth/token
OAUTH_CALLBACK_URL=http://localhost:3001/auth/oauth/callback

# Logging
LOG_LEVEL=info

# Security
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Email (for notifications - optional)
SMTP_HOST=smtp.company.com
SMTP_PORT=587
SMTP_USER=notifications@company.com
SMTP_PASS=your-smtp-password